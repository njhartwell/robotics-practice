DATABASE_URL=file:./data/tutorial.db
DATABASE_AUTH_TOKEN=
# TURSO_DATABASE_URL and TURSO_AUTH_TOKEN are also supported.
# DATABASE_* takes precedence; remove DATABASE_URL's local default to use TURSO_*.
# On Vercel use libsql://<database>.turso.io and its token above.
# Set BETTER_AUTH_URL to the deployment's HTTPS origin.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.19:3000
DEV_ALLOWED_ORIGINS=127.0.0.1,192.168.1.19
BOOTSTRAP_ADMIN_EMAILS=

# OAuth providers are enabled only when both credentials are present.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Mirror configured providers into the sign-in UI.
NEXT_PUBLIC_GITHUB_AUTH=false
NEXT_PUBLIC_GOOGLE_AUTH=false
NEXT_PUBLIC_MICROSOFT_AUTH=false

# Vercel always uses remote grading; local development defaults to auto.
KOTLIN_EXECUTION_MODE=auto
KOTLIN_API_SERVER=https://api.kotlinlang.org
KOTLIN_COMPILER_VERSION=2.0.21
KOTLIN_API_TIMEOUT_MS=15000
