DATABASE_URL=file:./data/tutorial.db
DATABASE_AUTH_TOKEN=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# OAuth providers are enabled only when both credentials are present.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Mirror configured providers into the sign-in UI.
NEXT_PUBLIC_GITHUB_AUTH=false
NEXT_PUBLIC_GOOGLE_AUTH=false
NEXT_PUBLIC_MICROSOFT_AUTH=false
