{
  "name": "robotics-practice",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.11",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:solutions": "bun scripts/validate-local-kotlin-solutions.mjs",
    "test:solutions:cli": "bun scripts/validate-kotlin-solutions.mjs",
    "test:kotlin-worker": "bun scripts/test-local-kotlin-runner.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "kotlin:worker:build": "bun scripts/build-kotlin-worker.mjs",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint && bun run typecheck && bun run test:run && bun run build",
    "check:all": "bun run kotlin:worker:build && bun run check && bun run test:kotlin-worker && bun run test:solutions"
  },
  "dependencies": {
    "@codemirror/lang-java": "^6.0.2",
    "@libsql/client": "^0.17.4",
    "@tailwindcss/typography": "^0.5.19",
    "@uiw/react-codemirror": "^4.25.9",
    "better-auth": "^1.6.26",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.7.0",
    "next": "16.2.2",
    "next-mdx-remote": "^6.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "jsdom": "^29.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.2"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
